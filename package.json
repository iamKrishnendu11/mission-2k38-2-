{
  "name": "mission2k38",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "cd ai_backend/api_service && uvicorn api:app --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend start",
    "start:backend": "npm --prefix backend start",
    "start:ai": "cd ai_backend/api_service && uvicorn api:app --port 8000"
  },
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
